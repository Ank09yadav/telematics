{
  "expo": {
    "name": "Telematics",
    "slug": "Telematics",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/spellBook-logo-original.png",
    "scheme": "telematics",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/spellBook-logo-original.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#08090C",
        "foregroundImage": "./assets/images/spellBook-logo-original.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/spellBook-logo-original.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08090C",
          "android": {
            "image": "./assets/images/spellBook-logo-original.png",
            "imageWidth": 120
          }
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
